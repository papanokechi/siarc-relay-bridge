expr=(1-r*x)*(1-x)**(-r), x=1/n
1 + x**2*(-r**2 - r*(-r - 1)/2) + x**3*(r**2*(-r - 1)/2 + r*(-r - 2)*(-r - 1)/6) + x**4*(-r**2*(-r - 2)*(-r - 1)/6 - r*(-r - 3)*(-r - 2)*(-r - 1)/24) + O(x**5)
coeff x^1: 0
coeff x^2: r*(1 - r)/2
coeff x^3: r*(1 - r**2)/3
coeff x^4: r*(1 - r)*(r + 1)*(r + 2)/8
log series: x**2*(-r**2/2 + r/2) + x**3*(-r**3/3 + r/3) + x**4*(-r**4/4 + r/4) + O(x**5)
